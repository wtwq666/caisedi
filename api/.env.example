# PostgreSQL（需 docker compose up -d 或本机 Postgres）
# DATABASE_URL=postgresql://caisedi:caisedi@localhost:5432/caisedi

# 无 Docker 时本地联调（SQLite，与 seed.py create_all 配合）
DATABASE_URL=sqlite:///./caisedi_dev.db
JWT_SECRET=change-me-in-production
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
STORAGE_BACKEND=local
STORAGE_ROOT=../storage
ASSETS_BASE_URL=http://localhost:8100/assets
CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100

# OSS (Phase 8, optional)
# OSS_ENDPOINT=
# OSS_BUCKET=
# OSS_ACCESS_KEY=
# OSS_SECRET_KEY=
